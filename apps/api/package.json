    "@fastify/rate-limit": "^10.3.0",
    "@lettera/blocks-standard": "workspace:*",
    "@lettera/core": "workspace:*",
    "@lettera/renderer": "workspace:*",
    "@prisma/client": "^6.18.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
