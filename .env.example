# ==============================================================================
# Lettera — example environment configuration
# ==============================================================================
# Copy this file to `.env` in the repo root (for docker-compose) and/or to
# `apps/api/.env` (for `pnpm --filter @lettera/api dev`) and fill in values.
# DO NOT commit real secrets. In production, use your platform's secret store.
# ------------------------------------------------------------------------------

# ---------- API ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Comma-separated list of web origins allowed via CORS + origin guard.
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Must be at least 16 characters. Rotate these in production.
JWT_SECRET=change-me-to-a-long-random-secret-please
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change-me-to-another-long-random-secret

# bcrypt cost factor (10–15). 13 ≈ ~250ms on commodity 2026 hardware.
BCRYPT_COST=13

# Rate-limit knobs (requests per minute per IP).
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=10

# Postgres connection string consumed by Prisma.
DATABASE_URL=postgresql://lettera:lettera@localhost:5432/lettera?schema=public

# ---------- Web (Next.js) -----------------------------------------------------
# Public; shipped to the browser bundle. Use your API's public URL in prod.
NEXT_PUBLIC_API_URL=http://localhost:4000
