{
  "name": "@lettera/renderer",
  "version": "0.1.0",
  "type": "module",
  "description": "Server-safe HTML renderer that turns Lettera documents into email-ready markup.",
  "license": "MIT",
  "author": "Marek Jelsik <marekjelsik@lignos.sk>",
  "homepage": "https://github.com/Marky926/lettera/tree/main/packages/renderer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marky926/lettera.git",
    "directory": "packages/renderer"
  },
  "bugs": {
    "url": "https://github.com/Marky926/lettera/issues"
  },
  "keywords": [
    "email",
    "email-builder",
    "lettera",
    "render",
    "html"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@lettera/core": "workspace:*",
    "@lettera/sdk": "workspace:*"
  },
  "devDependencies": {
    "@lettera/blocks-standard": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
