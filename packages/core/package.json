{
  "name": "@lettera/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core document model, schema, tokens, and commands for the Lettera email builder.",
  "license": "MIT",
  "author": "Marek Jelsik <marekjelsik@lignos.sk>",
  "homepage": "https://github.com/Marky926/lettera/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marky926/lettera.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Marky926/lettera/issues"
  },
  "keywords": [
    "email",
    "email-builder",
    "lettera",
    "document",
    "schema"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "import": "./dist/commands/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "nanoid": "^5.0.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
