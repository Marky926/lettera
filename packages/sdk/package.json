{
  "name": "@lettera/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "SDK for authoring custom blocks and extending the Lettera email builder.",
  "license": "MIT",
  "author": "Marek Jelsik <marekjelsik@lignos.sk>",
  "homepage": "https://github.com/Marky926/lettera/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marky926/lettera.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Marky926/lettera/issues"
  },
  "keywords": [
    "email",
    "email-builder",
    "lettera",
    "sdk",
    "blocks"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@lettera/core": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
