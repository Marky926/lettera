{
  "name": "@lettera/blocks-standard",
  "version": "0.1.0",
  "type": "module",
  "description": "Standard block library (text, image, button, layout, and more) for the Lettera email builder.",
  "license": "MIT",
  "author": "Marek Jelsik <marekjelsik@lignos.sk>",
  "homepage": "https://github.com/Marky926/lettera/tree/main/packages/blocks-standard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marky926/lettera.git",
    "directory": "packages/blocks-standard"
  },
  "bugs": {
    "url": "https://github.com/Marky926/lettera/issues"
  },
  "keywords": [
    "email",
    "email-builder",
    "lettera",
    "blocks",
    "components"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@lettera/core": "workspace:*",
    "@lettera/sdk": "workspace:*",
    "sanitize-html": "^2.17.3"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.1",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  }
}
