{
  "name": "@lettera/email-builder",
  "version": "0.1.0",
  "type": "module",
  "description": "Single-entrypoint meta-package that bundles the Lettera core, renderer, SDK, standard blocks, and React editor.",
  "license": "MIT",
  "author": "Marek Jelsik <marekjelsik@lignos.sk>",
  "homepage": "https://github.com/Marky926/lettera/tree/main/packages/email-builder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marky926/lettera.git",
    "directory": "packages/email-builder"
  },
  "bugs": {
    "url": "https://github.com/Marky926/lettera/issues"
  },
  "keywords": [
    "email",
    "email-builder",
    "lettera",
    "react",
    "wysiwyg"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "default": "./dist/editor.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "default": "./dist/hooks.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@lettera/blocks-standard": "workspace:*",
    "@lettera/core": "workspace:*",
    "@lettera/editor": "workspace:*",
    "@lettera/renderer": "workspace:*",
    "@lettera/sdk": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
