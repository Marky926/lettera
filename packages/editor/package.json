{
  "name": "@lettera/editor",
  "version": "0.0.1",
  "type": "module",
  "description": "React-based drag-and-drop visual editor for the Lettera email builder.",
  "license": "MIT",
  "author": "Marek Jelsik <marekjelsik@lignos.sk>",
  "homepage": "https://github.com/Marky926/lettera/tree/main/packages/editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marky926/lettera.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/Marky926/lettera/issues"
  },
  "keywords": [
    "email",
    "email-builder",
    "lettera",
    "editor",
    "react",
    "tiptap"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lettera/blocks-standard": "workspace:*",
    "@lettera/core": "workspace:*",
    "@lettera/renderer": "workspace:*",
    "@lettera/sdk": "workspace:*",
    "@tiptap/core": "^2.10.4",
    "@tiptap/extension-link": "^2.10.4",
    "@tiptap/pm": "^2.10.4",
    "@tiptap/react": "^2.10.4",
    "@tiptap/starter-kit": "^2.10.4",
    "cmdk": "^1.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
